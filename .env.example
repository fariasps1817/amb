APP_NAME="Coordenação de Ambulâncias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Fortaleza
APP_URL=http://amb.test

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@amb.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp
# driver: "link"      -> gera links wa.me para envio manual (padrao, sem custo)
#         "cloud"     -> WhatsApp Cloud API oficial da Meta
#         "evolution" -> Evolution API self-hosted
# ---------------------------------------------------------------------------
WHATSAPP_DRIVER=link
WHATSAPP_DDI=55
WHATSAPP_DDD_PADRAO=85

# Meta Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_VERSION=v21.0

# Evolution API
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_EVOLUTION_INSTANCE=

VITE_APP_NAME="${APP_NAME}"
